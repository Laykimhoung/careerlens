# Security settings
SECRET_KEY=replace-me-with-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Connection Option A: Single URL (Recommended for Neon / Render)
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Database Connection Option B: Discrete credentials (Default for local PostgreSQL)
DB_NAME=careerlens_db
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & CSRF Origins (Comma-separated URLs for your frontend and API domains)
# Add your deployed Vercel URL in production:
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://careerlens.vercel.app
# Add your deployed Render API URL in production:
CSRF_TRUSTED_ORIGINS=https://careerlens-api.onrender.com

# Demo Seed Credentials (Optional - for management command demo accounts)
DEMO_USER_PASSWORD=replace-me-with-demo-password