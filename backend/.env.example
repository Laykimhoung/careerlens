# CareerLens Backend Environment Variables Example

# Django Secret Key & Debug Mode
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL Database (Neon Serverless or Local)
DB_NAME=careerlens
DB_USER=neondb_owner
DB_PASSWORD=your-db-password
DB_HOST=ep-xxxx-pooler.us-east-2.aws.neon.tech
DB_PORT=5432
# Alternatively, use DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram Bot Integration (Optional; TELEGRAM_WEBHOOK_SECRET is required when DEBUG=False)
# TELEGRAM_BOT_TOKEN=your_botfather_token_here
# TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# Frontend Application URL & Production CORS/CSRF/Proxy Security
FRONTEND_URL=http://localhost:5173
CAREERLENS_WEB_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://careerlens.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
# DRF_NUM_PROXIES=1
# SECURE_SSL_REDIRECT=True

# Email Configuration (Gmail SMTP)
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Security -> App Passwords and generate a 16-character password for "CareerLens".
# 3. Enter your Gmail address and 16-character app password below.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CareerLens <no-reply@careerlens.app>

# Demo Mode (enabled by default in development)
ENABLE_DEMO_MODE=True
